# ============================================================
# Puesto de Chance API - Variables de entorno de ejemplo
# Copie este archivo a .env y ajuste los valores segun su entorno.
# ============================================================

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Puerto en el que escucha el servidor HTTP
PORT=3000

# Seguridad / autenticacion JWT
# IMPORTANTE: en produccion use un secreto largo, aleatorio y privado.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Reglas de negocio
ZONA_HORARIA=America/Bogota
MINUTOS_ANULACION=10
MINUTOS_CIERRE_VENTAS=15
APUESTA_MIN_CHANCE=500
APUESTA_MAX_CHANCE=50000
VALOR_BALOTO=5700
DIAS_CADUCIDAD_PREMIO=365

# Persistencia
# La version actual almacena los datos en memoria (src/data/store.js),
# por lo que NO requiere cadena de conexion a base de datos ni credenciales
# de servicios externos. Al reiniciar el proceso los datos se reinician.
